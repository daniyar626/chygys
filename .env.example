# Провайдер модели: gemini (бесплатный уровень) | claude
CQA_PROVIDER=gemini
# Ключ Gemini API (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
# Ключ Claude API (https://console.anthropic.com), если CQA_PROVIDER=claude
ANTHROPIC_API_KEY=

# Модель (пусто = по умолчанию: gemini-3.5-flash / claude-opus-5-5)
CQA_MODEL=
# Запасные модели Gemini при перегрузке (503) или лимите (429)
CQA_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash
# Глубина рассуждений Claude: low | medium | high
CQA_EFFORT=medium
# Сколько раз модель оценивает диалог (ответ по большинству). Обычные наборы — CQA_VOTES, контрольные — CQA_CONTROL_VOTES
CQA_VOTES=1
CQA_CONTROL_VOTES=3
# Контрольные наборы (group_id через запятую)
CQA_CONTROL_GROUPS=FBroker
# Сколько диалогов оценивать параллельно в пакетной оценке
# (по умолчанию 2 для Gemini, 4 для Claude)
CQA_CONCURRENCY=
PORT=3000

# Ссылка GET временного API организаторов (кнопка «Открыть GET для DEV» в задании) БЕЗ параметра &group_id=...
# Содержит токен доступа, поэтому хранится только в .env и не коммитится.
CQA_API_URL=

# Адрес, на котором слушает сервер (по умолчанию только этот компьютер)
# HOST=127.0.0.1

# Встраивание интерфейса в Dynamics 365 (HTML web resource на другом домене): разрешённые адреса страниц
# через запятую, «*.dynamics.com» — все поддомены по https. Пусто = только тот же адрес.
# CQA_CORS_ORIGINS=*.dynamics.com
