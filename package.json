{
  "name": "cqa-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Conversation Quality Analytics prototype (Freedom Broker CQA hackathon)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
